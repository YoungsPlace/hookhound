{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.py\" --flag",
            "timeoutMs": 10000
          },
          {
            "type": "process",
            "command": "node ./hooks/scripts/session-start.js",
            "timeoutMs": 10000
          },
          {
            "type": "process",
            "command": "node --require ./hooks/scripts/setup.js ./hooks/scripts/session-start.js",
            "timeoutMs": 10000
          },
          {
            "type": "process",
            "command": "/usr/bin/env python3 ${PLUGIN_ROOT}/hooks/scripts/check.py",
            "timeoutMs": 10000
          },
          {
            "type": "process",
            "command": "\"${PLUGIN_ROOT}/hooks/scripts/quoted.py\" --flag",
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
